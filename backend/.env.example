# ── Server ─────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────
# MongoDB Atlas connection string (or local mongodb://localhost:27017/hungry_helm)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hungry_helm?retryWrites=true&w=majority

# ── JWT Authentication ─────────────────────────────────────────
# Secret for signing tokens (minimum 32 random characters in production)
JWT_SECRET=your_jwt_secret_minimum_32_characters_here
JWT_EXPIRES_IN=7d

# ── CORS ───────────────────────────────────────────────────────
# Frontend URL where index.html is served (e.g., Live Server or local static server)
CLIENT_URL=http://127.0.0.1:5500
